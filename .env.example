# Student OS Environment Configuration
# None of these are required for standard local/mobile use.
# All schedule, calendar, tasks, and budget features work completely offline via localStorage.

# Optional: Firebase / Google Auth Configuration for Gmail Schedule Sync
# Can be configured in Vercel Project Settings -> Environment Variables:
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_APP_ID="1:..."
# VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
# VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="..."
# VITE_FIREBASE_OAUTH_CLIENT_ID="...apps.googleusercontent.com"

# AI Studio Service Keys (if using Gemini AI server-side)
GEMINI_API_KEY=""
APP_URL=""
